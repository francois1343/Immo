# Modèle des variables d'environnement du site.
# Copier ce fichier en `.env.local` (à la racine du projet), puis remplir les valeurs :
#   cp .env.example .env.local && chmod 600 .env.local
# `.env.local` n'est jamais dans Git. Next.js le lit au build ET au démarrage :
# après toute modification, refaire un build (en production : bash /home/sites.sh build immobiliermartin).
# Ne jamais écrire de vraie valeur dans ce fichier-ci : il est public.

# --- Envoi des demandes par e-mail (obligatoire) ---------------------------
# Mot de passe de la boîte no-reply@immobiliermartin.be.
# Vide = le formulaire n'envoie rien (il prépare seulement un e-mail au visiteur).
SMTP_PASSWORD=

# --- Google reCAPTCHA v3 (facultatif ; il faut les DEUX clés) --------------
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Seuil entre 0 et 1 (défaut 0.5)
#RECAPTCHA_MIN_SCORE=0.5

# --- Valeurs par défaut, à ne décommenter que pour les changer --------------
#SMTP_HOST=mail.immobiliermartin.be
#SMTP_PORT=465
#SMTP_TLS_NAME=mail.lwspanel.com
#SMTP_USER=no-reply@immobiliermartin.be
#MAIL_FROM=no-reply@immobiliermartin.be
#MAIL_TO=info@immobiliermartin.be
